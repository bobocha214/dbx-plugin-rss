{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.yuzhi.rss",
  "name": "RSS 阅读器",
  "version": "0.1.0",
  "publisher": "yuzhi",
  "description": "订阅 RSS/Atom 源，在 DBX 中管理和阅读文章。",
  "icon": "assets/plugin.svg",
  "engines": { "dbx": ">=0.6.0", "host_api": "1" },
  "permissions": [],
  "entrypoints": {
    "backend": { "protocol_versions": [1], "transport": "stdio-jsonl", "executable": "bin/dbx-plugin-rss" },
    "ui": { "root": "ui", "entry": "ui/index.html" }
  },
  "contributions": [
    { "type": "workbench", "id": "io.github.yuzhi.rss.workbench", "label": "RSS 阅读器", "icon": "assets/plugin.svg", "description": "订阅和阅读 RSS/Atom 文章。" }
  ],
  "localizations": { "zh-CN": { "name": "RSS 阅读器", "description": "订阅和阅读 RSS/Atom 文章。" } }
}
